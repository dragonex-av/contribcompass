# Create a Google AI Studio key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Keep this configurable: choose an available Gemma model in your AI Studio account.
GEMMA_MODEL=gemma-4-26b-a4b-it
# Local semantic embeddings. The app falls back to keyword retrieval if unavailable.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# GitHub OAuth app: https://github.com/settings/applications/new
# Set Homepage URL and Authorization callback URL to http://localhost:8501/
# For hosted use, set GITHUB_REDIRECT_URI to your HTTPS app URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8501/
